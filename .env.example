# Copie ce fichier en .env.local (développement) et renseigne les valeurs.
# Sur Vercel : Project > Settings > Environment Variables (voir README.md).
# Ne commite JAMAIS .env.local ni une clé réelle.

# Domaine public du site, sans slash final (ex : https://mon-portfolio.com).
# Laisse vide tant que le domaine n'est pas connu : aucune balise canonique,
# aucun sitemap et aucune URL absolue inventée ne seront publiés.
NEXT_PUBLIC_SITE_URL=

# Formulaire de contact (Resend : https://resend.com)
# Clé secrète, utilisée uniquement côté serveur (jamais exposée au navigateur).
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire.
CONTACT_TO_EMAIL=
# Expéditeur. Laisse vide pour utiliser l'adresse de test de Resend
# (« Portfolio <onboarding@resend.dev> », qui n'envoie qu'à l'adresse de ton compte Resend).
# Pour un usage réel, vérifie ton domaine sur Resend puis indique par ex. : Portfolio <contact@ton-domaine.com>
CONTACT_FROM_EMAIL=
